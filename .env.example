# Instagram App Credentials (server-side — set these in Vercel env vars)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Database (Neon connection string)
POSTGRES_URL=

# Supabase (for video storage)
SUPABASE_URL=
