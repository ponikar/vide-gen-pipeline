# Instagram App Credentials (server-side — set these in Vercel env vars)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Database (Neon connection string)
POSTGRES_URL=

# Supabase (for video storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI model provider (google or minimax)
AI_PROVIDER=google

# Public app/API URLs
APP_URL=https://your-app.example.com
VERCEL_API_URL=https://your-app.example.com
TIKTOK_REDIRECT_URI=https://your-app.example.com/api/auth/tiktok/callback

# TikTok App Credentials (server-side)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_SANDBOX_APP_ID=
TIKTOK_SANDBOX_APP_SECRET=
TIKTOK_MODE=production
