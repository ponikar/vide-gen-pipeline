{
  "name": "gold-fish",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "generate": "tsx src/cli.ts",
    "connect": "tsx scripts/connect.ts",
    "upload": "tsx scripts/upload.ts",
    "post": "tsx src/post.ts",
    "analytics": "tsx src/analytics.ts",
    "migrate": "tsx scripts/migrate.ts",
    "instagram:setup": "tsx scripts/connect.ts instagram",
    "instagram:post": "tsx src/post.ts instagram",
    "instagram:analytics": "tsx src/analytics.ts instagram",
    "voice:create": "tsx scripts/create-voice.ts",
    "setup:cloner": "python3 scripts/run-cloner.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dev:video": "pnpm --filter @gold-fish/video-server dev",
    "dev:next": "pnpm --filter @gold-fish/web dev",
    "dev:agent": "pnpm --filter @gold-fish/agent-worker dev"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.108.1",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "kokoro-js": "^1.2.1",
    "playwright": "^1.61.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.15.34",
    "@vercel/node": "^5.8.14",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
